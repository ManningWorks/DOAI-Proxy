# ==================== PROVIDER CONFIGURATION ====================
# Provider type (required)
# Options: straico (For now, I can add more providers as needed.)
# Default: straico
PROVIDER_TYPE=straico

# ==================== STRAICO CONFIGURATION ====================
# Only required if PROVIDER_TYPE=straico
STRAICO_API_KEY=your_straico_api_key_here
STRAICO_API_URL=https://api.straico.com/v2
STRAICO_API_TIMEOUT=60000

# Interval in milliseconds to periodically refresh model limits from Straico API.
# Set to 0 or leave unset to disable periodic refresh (limits fetched only at startup).
# Example: 1800000 = 30 minutes
# MODEL_LIMITS_REFRESH_INTERVAL=1800000

# Maximum character length for tool result messages sent to the provider.
# Set to -1 or leave unset to disable truncation (full content sent).
# TOOL_RESULT_MAX_LENGTH=5000

# ==================== CONVERSATION SUMMARIZATION ====================
# Enable conversation summarization for long sessions.
# When enabled, older messages are replaced with a summary when estimated
# input tokens exceed a percentage of the model's context limit.
# Default: false (disabled)
# SUMMARIZATION_ENABLED=false

# Percentage of model's context limit that triggers summarization.
# When estimated input tokens exceed this percentage, older messages
# are summarized. Lower values = more aggressive summarization.
# Default: 70
# SUMMARIZATION_THRESHOLD_PCT=70

# Number of recent messages to keep verbatim (not summarized).
# System messages are always preserved regardless of this setting.
# Default: 10
# SUMMARIZATION_KEEP_MESSAGES=10

# Model to use for summarization API calls.
# Set to "auto" (default) to use Straico's smart_llm_selector for
# automatic balance-optimized model selection.
# Or set to a specific model ID (e.g., "meta-llama/llama-3.1-8b-instruct").
# SUMMARIZATION_MODEL=auto

# Timeout in milliseconds for summarization API calls.
# If summarization exceeds this time, original messages are sent unchanged.
# Default: 15000 (15 seconds)
# SUMMARIZATION_TIMEOUT=15000

# ==================== AUTHENTICATION CONFIGURATION ====================
# Authentication mode (default: required in production, optional in development)
# Options:
#   - required: Require PROXY_API_KEY, fail if missing (safest for production)
#   - optional: Use PROXY_API_KEY if set, warn if not (good for development)
#   - disabled: Explicitly disable authentication (for isolated environments, CI/CD)
#   - external: Auth handled externally (Kubernetes with service mesh, API gateway)
AUTH_MODE=required

# Proxy API key (required when AUTH_MODE=required or optional)
# Configure your OpenCode or client with this key
PROXY_API_KEY=your_proxy_secret_key_here

# External auth header name (when AUTH_MODE=external)
# Example: X-API-Gateway-Auth, X-Forwarded-User
EXTERNAL_AUTH_HEADER=

# ==================== ENVIRONMENT ====================
NODE_ENV=development

# ==================== PROXY CONFIGURATION ====================
PROXY_PORT=8000

# ==================== STREAMING SIMULATION ====================
# Used for providers without native streaming (Straico)
# Streaming mode options:
#   - none:    Send whole response as-is (recommended default, no formatting issues, fastest)
#   - smart:    Demo/showcase mode with boundary-aware chunking (may introduce formatting issues)
STREAM_MODE=none

# Chunk size for 'smart' mode (ignored for 'none' mode)
STREAM_CHUNK_SIZE=15

# Delay between chunks in milliseconds
STREAM_DELAY_MS=80

# ==================== RETRY CONFIGURATION ====================
# Maximum number of retry attempts for transient upstream errors (429, 5xx, network errors).
# Set to 1 to disable retries (single attempt only).
# Default: 3
# RETRY_MAX_ATTEMPTS=3

# Base delay in milliseconds for exponential backoff between retries.
# Actual delay = base * 2^(attempt-1) + random jitter.
# Default: 1000
# RETRY_BASE_DELAY_MS=1000

# ==================== LOGGING ====================

LOG_LEVEL=info

# Log Rotation Configuration (optional, has defaults)
MAX_LOG_SIZE=50              # Max log file size in MB before rotation
MAX_LOG_FILES=5             # Number of archived log files to keep
