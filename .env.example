# ==================== PROVIDER CONFIGURATION ====================
# Provider type (required)
# Options: straico (For now, I can add more providers as needed.)
# Default: straico
PROVIDER_TYPE=straico

# ==================== STRAICO CONFIGURATION ====================
# Only required if PROVIDER_TYPE=straico
STRAICO_API_KEY=your_straico_api_key_here
STRAICO_API_URL=https://api.straico.com/v2
STRAICO_API_TIMEOUT=60000

# ==================== AUTHENTICATION CONFIGURATION ====================
# Authentication mode (default: required in production, optional in development)
# Options:
#   - required: Require PROXY_API_KEY, fail if missing (safest for production)
#   - optional: Use PROXY_API_KEY if set, warn if not (good for development)
#   - disabled: Explicitly disable authentication (for isolated environments, CI/CD)
#   - external: Auth handled externally (Kubernetes with service mesh, API gateway)
AUTH_MODE=required

# Proxy API key (required when AUTH_MODE=required or optional)
# Configure your OpenCode or client with this key
PROXY_API_KEY=your_proxy_secret_key_here

# External auth header name (when AUTH_MODE=external)
# Example: X-API-Gateway-Auth, X-Forwarded-User
EXTERNAL_AUTH_HEADER=

# ==================== ENVIRONMENT ====================
NODE_ENV=development

# ==================== PROXY CONFIGURATION ====================
PROXY_PORT=8000

# ==================== STREAMING SIMULATION ====================
# Used for providers without native streaming (Straico)
STREAM_CHUNK_SIZE=15
STREAM_DELAY_MS=80

# ==================== LOGGING ====================

LOG_LEVEL=info

# Log Rotation Configuration (optional, has defaults)
MAX_LOG_SIZE=50              # Max log file size in MB before rotation
MAX_LOG_FILES=5             # Number of archived log files to keep
